{
  "name": "famplaner",
  "private": true,
  "description": "FamPlaner – Familien-App (Expo + Supabase)",
  "scripts": {
    "setup": "npm --prefix apps/mobile ci",
    "start": "npm --prefix apps/mobile start",
    "web": "npm --prefix apps/mobile run web",
    "lint": "npm --prefix apps/mobile run lint",
    "typecheck": "npm --prefix apps/mobile run typecheck",
    "test": "npm --prefix apps/mobile test",
    "check": "npm run lint && npm run typecheck && npm test",
    "db:start": "supabase start",
    "db:reset": "supabase db reset",
    "db:test": "supabase test db"
  },
  "engines": {
    "node": ">=22"
  },
  "devDependencies": {
    "supabase": "3.1.0"
  }
}
